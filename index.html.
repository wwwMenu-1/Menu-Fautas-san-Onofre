<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Flautas San Onofre — Menú</title>
<style>
:root{
  --yellow:#f7d515; --orange:#e0781c; --orange-dark:#b85c14; --ink:#2b2109; --cream:#fffaf0;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
*{box-sizing:border-box;}
body{margin:0;font-family:'Trebuchet MS',Verdana,sans-serif;background:var(--cream);color:var(--ink);}
header{background:linear-gradient(135deg,var(--orange),var(--orange-dark));color:#fff;padding:28px 18px 20px;text-align:center;position:sticky;top:env(safe-area-inset-top,0px);z-index:10;box-shadow:0 2px 8px rgba(0,0,0,.15);}
header h1{margin:0;font-size:1.6rem;letter-spacing:.5px;}
header p{margin:6px 0 0;font-size:.85rem;opacity:.95;}
nav{display:flex;overflow-x:auto;gap:8px;background:var(--orange-dark);padding:10px 12px;position:sticky;top:calc(72px + env(safe-area-inset-top,0px));z-index:9;-webkit-overflow-scrolling:touch;}
nav a{flex:0 0 auto;color:#fff;text-decoration:none;font-size:.8rem;background:rgba(255,255,255,.15);padding:6px 12px;border-radius:20px;white-space:nowrap;}
main{max-width:640px;margin:0 auto;padding:16px;}
section{margin-bottom:26px;border:3px solid #1a1508;border-radius:14px;padding:14px 14px 4px;background:rgba(255,255,255,.5);}
section h2{background:var(--yellow);color:var(--ink);display:inline-block;padding:5px 16px;border-radius:8px;font-size:1.15rem;margin:0 0 10px;}
.note{font-style:italic;font-size:.8rem;color:var(--orange-dark);margin:-4px 0 8px;}
.card{background:#fdead0;border:1px solid #f0c98a;border-radius:12px;padding:10px 14px;margin-bottom:8px;box-shadow:0 1px 3px rgba(0,0,0,.06);}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:.95rem;}
.row .name{flex:1;}
.price{font-weight:bold;color:var(--orange-dark);white-space:nowrap;}
.sub{font-size:.75rem;color:#7a6a3a;margin-top:2px;}
.group-price{font-size:1.05rem;color:var(--orange-dark);font-weight:900;margin-bottom:8px;letter-spacing:.3px;}
.cols{display:flex;gap:16px;flex-wrap:wrap;}
.cols div{flex:1;min-width:130px;}
.tags{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.95rem;}
.tags span{white-space:nowrap;}
footer{background:var(--orange-dark);color:#fff;text-align:center;padding:22px 16px 28px;font-size:.85rem;}
footer a{color:var(--yellow);text-decoration:none;font-weight:bold;}
.hours{background:#fff3d0;border-radius:10px;padding:10px 14px;font-size:.85rem;margin:10px auto 0;max-width:640px;}
.gallery{display:flex;gap:10px;overflow-x:auto;margin:10px 0 6px;-webkit-overflow-scrolling:touch;}
.gallery img{width:150px;height:150px;object-fit:cover;border-radius:12px;flex:0 0 auto;box-shadow:0 2px 6px rgba(0,0,0,.15);}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){--cream:#1b1608;--ink:#f5ecd0;}
  :root:not([data-theme="light"]) .card{background:#241d0d;border-color:#4a3d18;}
  :root:not([data-theme="light"]) .sub, :root:not([data-theme="light"]) .group-price{color:#c9b06a;}
  :root:not([data-theme="light"]) .hours{background:#3a2e0f;color:#f5ecd0;}
}
</style>
</head>
<body>
<header>
  <img src="data:image/jpeg;base64," alt="Flautas San Onofre" style="width:92px;height:92px;border-radius:50%;background:#fff;padding:4px;border:4px solid #1a1508;box-shadow:0 2px 6px rgba(0,0,0,.25);">
  <h1>Flautas San Onofre</h1>
  <p>Flautas · Crepas · Waffles · Frappés · Malteadas</p>
</header>
<nav>
  <a href="#flautas">Flautas</a>
  <a href="#snacks">Snacks</a>
  <a href="#crepas">Crepas</a>
  <a href="#dulces">Dulces</a>
  <a href="#bebidas-frias">Frías</a>
  <a href="#bebidas-calientes">Bebidas</a>
  <a href="#postres">Postres</a>
</nav>
<div class="hours">
  🕕 <strong>Lun–Vie:</strong> 6:30pm–11:30pm &nbsp;|&nbsp; <strong>Sáb–Dom:</strong> 4:30pm–11:30pm<br>
  📍 Hacienda Santiago #2609-A &nbsp;·&nbsp; 🛵 Servicio a domicilio
</div>
<main>

<section id="flautas">
  <h2>Flautas</h2>
  <div class="group-price">$26 c/u</div>
  <div class="gallery">
    <img src="data:image/jpeg;base64," alt="Flautas San Onofre">
  </div>
  <div class="card"><div class="tags">
    <span>• Res sin chile</span><span>• Res con chile</span><span>• Barbacoa</span>
    <span>• Requesón</span><span>• Pollo a las finas hierbas</span><span>• Pollo con chipotle</span>
  </div></div>
</section>

<section id="snacks">
  <h2>Snacks</h2>
  <div class="group-price">$70 c/u</div>
  <div class="card"><div class="tags">
    <span>• Papas a la francesa</span><span>• Papas gajo</span><span>• Salchipulpos</span>
  </div></div>
</section>

<section id="crepas">
  <h2>Crepas</h2>
  <div class="card">
    <strong>Saladas</strong> <span class="price">$89</span>
    <div class="tags" style="margin-top:6px">
      <span>• Jamón</span><span>• Chorizo</span><span>• Queso</span><span>• Philadelphia</span><span>• Salchicha</span>
    </div>
  </div>
  <div class="card">
    <strong>Especiales</strong> <span class="price">$99</span>
    <div class="tags" style="margin-top:6px">
      <span>• Pollo finas hierbas</span><span>• Pollo c/ chipotle</span>
    </div>
  </div>
</section>

<section id="dulces">
  <h2>Crepas dulces & Waffles</h2>
  <div class="gallery">
    <img src="data:image/jpeg;base64," alt="Waffle con fresas y helado">
    <img src="data:image/jpeg;base64," alt="Waffle con plátano y helado">
  </div>
  <div class="card">
    <div class="row"><span>Crepas dulces</span><span class="price">$79</span></div>
    <div class="row"><span>Waffles</span><span class="price">$89</span></div>
    <div class="tags" style="margin-top:8px">
      <span>• Miel maple</span><span>• Nutella</span><span>• Cajeta</span><span>• M. de fresa</span>
      <span>• M. de zarzamora</span><span>• Lechera</span><span>• Philadelphia</span><span>• Crema de maní</span>
      <span>• Fresa</span><span>• Plátano</span><span>• Frutos rojos</span><span>• Nieve de vainilla</span>
      <span>• Nieve napolitana</span>
    </div>
  </div>
</section>

<section id="bebidas-frias">
  <h2>Frappés, Malteadas & más</h2>
  <div class="card">
    <div class="row"><span class="name">Smoothies</span><span class="price">$49</span></div>
    <div class="sub">Fresa · Frambuesa · Zarzamora · Frutos rojos · Mango · Piña colada · Plátano</div>
  </div>
  <div class="card">
    <div class="row"><span class="name">Frozen</span><span class="price">$49</span></div>
    <div class="sub">Mango · Limón · Fresa <em>(puede incluir chamoy al gusto)</em></div>
  </div>
  <div class="card">
    <div class="row"><span class="name">Frappés</span><span class="price">$49</span></div>
    <div class="sub">Chocolate · Oreo · Vainilla · Nuez · Cajeta · Moka · Fresa · Café</div>
    <div class="row" style="margin-top:6px"><span class="name">Rompope / Bailey's</span><span class="price">$59</span></div>
    <div class="row"><span class="name">Ferrero</span><span class="price">$79</span></div>
  </div>
  <div class="card">
    <div class="row"><span class="name">Malteadas</span><span class="price">$49</span></div>
    <div class="sub">Chocolate · Oreo · Vainilla · Nuez · Cajeta · Moka · Café · Philadelphia · Fresa</div>
    <div class="row" style="margin-top:6px"><span class="name">Rompope / Bailey's</span><span class="price">$59</span></div>
  </div>
</section>

<section id="bebidas-calientes">
  <h2>Bebidas</h2>
  <div class="card">
    <div class="cols">
      <div>
        <div class="row"><span class="name">Agua fresca (CH)</span><span class="price">$22</span></div>
        <div class="row"><span class="name">Agua fresca (GDE)</span><span class="price">$35</span></div>
        <div class="row"><span class="name">Refresco</span><span class="price">$25</span></div>
      </div>
      <div>
        <div class="row"><span class="name">Chocolate caliente (Mayordomo)</span><span class="price">$45</span></div>
        <div class="row"><span class="name">Capuchino</span><span class="price">$45</span></div>
        <div class="row"><span class="name">Chocomilk</span><span class="price">$45</span></div>
      </div>
    </div>
  </div>
</section>

<section id="postres">
  <h2>Postres</h2>
  <div class="card">
    <div class="row"><span class="name">Cheesecake zarzamora</span><span class="price">$70</span></div>
    <div class="row"><span class="name">Cheesecake chocolate</span><span class="price">$70</span></div>
  </div>
</section>

<section id="compartir">
  <h2>Comparte este menú</h2>
  <div class="card" style="text-align:center;">
    <div id="qrcode-box" style="display:flex;justify-content:center;margin-bottom:10px;"></div>
    <p style="font-size:.85rem;margin:0 0 4px;">Escanea el código QR o comparte el enlace:</p>
    <a id="menu-link" href="#" style="font-size:.85rem;font-weight:bold;color:var(--orange-dark);word-break:break-all;"></a>
  </div>
</section>

</main>
<footer>
  📍 Hacienda Santiago #2609-A<br>
  📞 <a href="tel:3324854858">33 2485 4858</a><br>
  🛵 Servicio a domicilio<br>
  Síguenos: Instagram &amp; Facebook — Flautas San Onofre
</footer>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.0.3/qrcode.min.js"></script>
<script>
try {
  var pageUrl = window.location.href;
  var qr = qrcode(0, 'M');
  qr.addData(pageUrl);
  qr.make();
  document.getElementById('qrcode-box').innerHTML = qr.createImgTag(5, 8);
  var linkEl = document.getElementById('menu-link');
  linkEl.textContent = pageUrl;
  linkEl.href = pageUrl;
} catch (e) {
  console.error('QR generation failed', e);
}
</script>
</body>
</html>
